# Example .env for DevTriage AI (personal_agent)
# IMPORTANT: Never commit a real .env file or secrets into git. This file is a template only.

# GitHub Personal Access Token (minimal scopes recommended: notifications, repo if needed)
GITHUB_TOKEN=your_github_personal_access_token

# Google Gemini / Vertex AI API key (optional)
GEMINI_API_KEY=your_gemini_api_key

# OpenAI API key (optional - used for draft generation)
OPENAI_API_KEY=your_openai_api_key

# Gmail OAuth credentials (optional - required only if you enable Gmail integration)
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret

# Optional settings
LOG_LEVEL=INFO

# Usage:
# 1. Copy this file to personal_agent/.env
# 2. Populate the values with your real secrets locally (do NOT commit)
# 3. Ensure .env is listed in .gitignore
